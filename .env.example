# ── 노션 연동 ─────────────────────────────────────────────
# notion.so/my-integrations 에서 발급한 내부 통합(Internal Integration) 시크릿
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 글 데이터베이스 ID (노션 DB URL의 32자리 문자열)
# 예: notion.so/워크스페이스/1a2b3c4d5e6f7890abcdef1234567890?v=...
#     → 1a2b3c4d5e6f7890abcdef1234567890
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 사이트 주소 ────────────────────────────────────────────
# 최종적으로 글이 노출될 도메인. canonical·사이트맵·JSON-LD에 쓰인다.
# 서브디렉터리 운영: https://dowonhr.com
# 서브도메인 운영:   https://blog.dowonhr.com
NEXT_PUBLIC_SITE_URL=https://dowonhr.com
